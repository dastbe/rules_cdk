"""rules_cfn: author CloudFormation in typed Starlark generated from CloudFormation specs."""

module(
    name = "rules_cfn",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.97.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "cfnctl_crates",
    cargo_lockfile = "//cfnctl:Cargo.lock",
    manifests = ["//cfnctl:Cargo.toml"],
)
use_repo(crate, "cfnctl_crates")

cfn = use_extension("//cfn:extensions.bzl", "cfn")

# Default spec: a pinned, vendored subset of the us-east-1 registry schemas (IAM,
# Lambda, API Gateway, DynamoDB, S3, Logs; see third_party/cfn_schemas). A root
# module that declares its own cfn.spec(name = "cfn") replaces it.
cfn.spec(
    name = "cfn",
    schema_dirs = ["//third_party/cfn_schemas:README.md"],
)
use_repo(cfn, "cfn")

# Development-only: AWS's unpinned "latest" archive, for the full-spec codegen
# smoke test (`bazel test //cfn/tests:full_spec_check_test`). Its contents change
# without notice.
cfn_dev = use_extension("//cfn:extensions.bzl", "cfn", dev_dependency = True)
cfn_dev.spec(
    name = "cfn_latest",
    urls = ["https://schema.cloudformation.us-east-1.amazonaws.com/CloudformationSchema.zip"],
)
use_repo(cfn_dev, "cfn_latest")
