+							err = fmt.Errorf("%s (did you mean %s?)", err, n)
+						}
+						break loop
+					}
+					members[to] = v
+				}
+				sp -= 2 * n
+			}
+			stack[sp] = &LoadedModule{name: module, members: members}
+			sp++
+
+			// Check whether Load callback cancelled the thread.
+			if thread.checkSteps() {
+				if err = thread.checkStepsSlow(); err != nil {
+					break loop
+				}
+			}
+
 		case compile.SETLOCAL:
 			locals[arg] = stack[sp-1]
 			sp--
@@ -762,3 +802,22 @@ func (c *cell) Freeze() {
 }
 func (c *cell) Truth() Bool           { panic("unreachable") }
 func (c *cell) Hash() (uint32, error) { panic("unreachable") }
+
+// load calls the thread's Load function for the specified module,
+// as required by the LOAD and LOADMODULE instructions.
+func (thread *Thread) load(module string) (StringDict, error) {
+	if thread.Load == nil {
+		return nil, fmt.Errorf("load not implemented by this application")
+	}
+
+	thread.endProfSpan()
+	dict, err := thread.Load(thread, module)
+	thread.beginProfSpan()
+	if err != nil {
+		return nil, wrappedError{
+			msg:   fmt.Sprintf("cannot load %s: %v", module, err),
+			cause: err,
+		}
+	}
+	return dict, nil
+}
diff --git a/starlark/loadedmodule.go b/starlark/loadedmodule.go
new file mode 100644
index 0000000..d8942e3
--- /dev/null
+++ b/starlark/loadedmodule.go
@@ -0,0 +1,50 @@
+// Copyright 2026 The Bazel Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package starlark
+
+import "fmt"
+
+// A LoadedModule is the value bound by the assignment form of the load
+// statement, which requires the [syntax.FileOptions.LoadModule] option.
+//
+// Whereas an ordinary load statement binds the listed names in the
+// file scope,
+//
+//	load("module", "x", y="z")
+//
+// the assignment form binds them as attributes of a single variable:
+//
+//	m = load("module", "x", y="z")   # m.x, m.y
+//
+// If no names are listed, as in m = load("module"), the attributes are
+// all the exported members of the StringDict returned by the thread's
+// Load function, that is, those whose names do not begin with an
+// underscore.
+type LoadedModule struct {
+	name    string
+	members StringDict
+}
+
+var _ HasAttrs = (*LoadedModule)(nil)
+
+// Name returns the module name passed to load.
+func (m *LoadedModule) Name() string { return m.name }
+
+// Members returns a new StringDict containing the module's attributes.
+func (m *LoadedModule) Members() StringDict {
+	r := make(StringDict, len(m.members))
+	for k, v := range m.members {
+		r[k] = v
+	}
+	return r
+}
+
+func (m *LoadedModule) Attr(name string) (Value, error) { return m.members[name], nil }
+func (m *LoadedModule) AttrNames() []string             { return m.members.Keys() }
+func (m *LoadedModule) Freeze()                         { m.members.Freeze() }
+func (m *LoadedModule) Hash() (uint32, error)           { return 0, fmt.Errorf("unhashable: %s", m.Type()) }
+func (m *LoadedModule) String() string                  { return fmt.Sprintf("<module %q>", m.name) }
+func (m *LoadedModule) Truth() Bool                     { return true }
+func (m *LoadedModule) Type() string                    { return "module" }
diff --git a/starlark/testdata/loadmodule.star b/starlark/testdata/loadmodule.star
new file mode 100644
index 0000000..4e88d3a
--- /dev/null
+++ b/starlark/testdata/loadmodule.star
@@ -0,0 +1,86 @@
+# Tests of the assignment form of load: name = load("module").
+# option:loadmodule
+
+load("assert.star", "assert")
+
+lib = load("loadmodule_lib.star")
+
+assert.eq(type(lib), "module")
+assert.eq(str(lib), '<module "loadmodule_lib.star">')
+assert.true(lib)
+assert.eq(lib.double(21), 42)
+assert.eq(lib.greeting, "hello")
+assert.eq(lib.numbers, [1, 2, 3])
+
+# Functions may use the module's private members internally...
+assert.eq(lib.reveal(), "hidden")
+
+# ...but names beginning with underscore are not exported.
+assert.eq(dir(lib), ["double", "greeting", "numbers", "reveal"])
+assert.true(not hasattr(lib, "_private"))
+assert.fails(lambda: lib._private, "module has no ._private field or method")
+assert.fails(lambda: lib._secret, "module has no ._secret field or method")
+
+# no such field, with spelling suggestions
+assert.fails(lambda: lib.doubel, "module has no .doubel field or method .did you mean .double\\?")
+
+# Loaded modules are immutable and unhashable.
+def assignfield():
+    lib.greeting = "bye"
+
+assert.fails(assignfield, "can't assign to .greeting field of module")
+assert.fails(lambda: lib.numbers.append(4), "cannot append to frozen list")
+assert.fails(lambda: {lib: None}, "unhashable: module")
+
+# A module bound this way is an ordinary first-class value.
+def call_via(m, x):
+    return m.double(x)
+
+assert.eq(call_via(lib, 5), 10)
+assert.eq(getattr(lib, "greeting"), "hello")
+
+---
+# option:loadmodule
+load("assert.star", "assert")
+
+# Both forms may load the same module.
+# (The test loader does not cache modules, so the functions are distinct.)
+lib = load("loadmodule_lib.star")
+load("loadmodule_lib.star", "double")
+assert.eq(lib.double(3), double(3))
+
+---
+# option:loadmodule
+# Forward references from functions are allowed, as with ordinary loads.
+load("assert.star", "assert")
+
+def f():
+    return lib.greeting
+
+lib = load("loadmodule_lib.star")
+assert.eq(f(), "hello")
+
+---
+# option:loadmodule
+lib = load("nonesuch.star") ### "cannot load nonesuch.star"
+
+---
+# option:loadmodule
+# The assignment form may list names, binding them as attributes of
+# the module value instead of in the file scope.
+load("assert.star", "assert")
+
+lib = load("loadmodule_lib.star", "double", hi="greeting")
+assert.eq(dir(lib), ["double", "hi"])
+assert.eq(lib.double(4), 8)
+assert.eq(lib.hi, "hello")
+assert.fails(lambda: lib.greeting, "module has no .greeting field or method")
+assert.fails(lambda: lib.reveal, "module has no .reveal field or method")
+
+---
+# option:loadmodule
+lib = load("loadmodule_lib.star", "nonesuch") ### "load: name nonesuch not found in module loadmodule_lib.star"
+
+---
+# option:loadmodule
+lib = load("loadmodule_lib.star", "dubble") ### "did you mean double"
