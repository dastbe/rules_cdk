+
+// load calls the thread's Load function for the specified module,
+// as required by the LOAD and LOADMODULE instructions.
+func (thread *Thread) load(module string) (StringDict, error) {
+	if thread.Load == nil {
+		return nil, fmt.Errorf("load not implemented by this application")
+	}
+
+	thread.endProfSpan()
+	dict, err := thread.Load(thread, module)
+	thread.beginProfSpan()
+	if err != nil {
+		return nil, wrappedError{
+			msg:   fmt.Sprintf("cannot load %s: %v", module, err),
+			cause: err,
+		}
+	}
+	return dict, nil
+}
