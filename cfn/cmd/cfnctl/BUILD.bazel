load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "cfnctl_lib",
    srcs = [
        "main.go",
        "remote.go",
    ],
    importpath = "github.com/dastbe/rules_cdk/cfn/cmd/cfnctl",
    visibility = ["//visibility:private"],
    deps = [
        "//cfn/internal/deploy",
        "//cfn/internal/manifest",
        "//cfn/internal/packager",
        "//cfn/internal/validate",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_cloudformation//:cloudformation",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_aws_aws_sdk_go_v2_service_sts//:sts",
    ],
)

go_binary(
    name = "cfnctl",
    embed = [":cfnctl_lib"],
    visibility = ["//visibility:public"],
)
