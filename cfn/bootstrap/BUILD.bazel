load("//cfn:defs.bzl", "cfn_stack")

# The asset bucket cfnctl uploads to. Once per account + region:
#   bazel run @rules_cfn//cfn/bootstrap:bootstrap.deploy
# (deployed with whatever region/credentials the environment provides).
cfn_stack(
    name = "bootstrap",
    src = "bootstrap.star",
    stack_name = "RulesCfnBootstrap",
    visibility = ["//visibility:public"],
)
