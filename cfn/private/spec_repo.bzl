"""Repository rule that fetches CloudFormation registry schemas.

The bindings themselves are generated by a build action (`cfn_bindings`, which
runs `cfnctl gen`), so this rule only lays the schemas out in layers:

    schemas/0/...      first archive
    schemas/1/...      overlays, in order
    schemas/dir0/...   local schema directories
"""

def _json_files(rctx, root):
    out = []
    stack = [rctx.path(root)]
    for _ in range(1 << 20):
        if not stack:
            break
        d = stack.pop()
        for e in d.readdir():
            if e.is_dir:
                stack.append(e)
            elif e.basename.endswith(".json"):
                out.append(e)
    return sorted(out, key = lambda p: str(p))

_BUILD = """\
load("@rules_cfn//cfn/private:bindings.bzl", "cfn_bindings")

filegroup(
    name = "schemas",
    srcs = glob(["schemas/**/*.json"]),
    visibility = ["//visibility:public"],
)

# Typed .star bindings, one file per resource type: load("@{name}//aws/s3:bucket.star", ...)
cfn_bindings(
    name = "bindings",
    repo_name = "{name}",
    layers = {layers},
    schemas = [":schemas"],
    include = {include},
    exclude = {exclude},
    visibility = ["//visibility:public"],
)
"""

def _cfn_spec_repo_impl(rctx):
    layers = []
    for i, raw in enumerate(rctx.attr.archives):
        a = json.decode(raw)
        out = "schemas/{}".format(i)
        rctx.download_and_extract(
            url = a["urls"],
            sha256 = a.get("sha256", ""),
            stripPrefix = a.get("strip_prefix", ""),
            output = out,
            type = a.get("type", ""),
        )
        layers.append(out)
    for i, marker in enumerate(rctx.attr.schema_dirs):
        src = rctx.path(marker).dirname
        rctx.watch_tree(src)
        out = "schemas/dir{}".format(i)
        for f in _json_files(rctx, src):
            rctx.symlink(f, "{}/{}".format(out, f.basename))
        layers.append(out)
    if not layers:
        fail("cfn spec {}: no archives or schema directories given".format(rctx.attr.apparent_name))
    rctx.file("BUILD.bazel", _BUILD.format(
        name = rctx.attr.apparent_name,
        layers = repr(layers),
        include = repr(rctx.attr.include),
        exclude = repr(rctx.attr.exclude),
    ))

cfn_spec_repo = repository_rule(
    implementation = _cfn_spec_repo_impl,
    doc = "Fetches CloudFormation registry schema archives; `:bindings` generates typed .star bindings from them.",
    attrs = {
        "apparent_name": attr.string(mandatory = True, doc = "Name the bindings are loaded as, e.g. \"cfn\" for @cfn//aws/s3:bucket.star."),
        "archives": attr.string_list(doc = "JSON-encoded {urls, sha256, strip_prefix, type} per archive layer, in order."),
        "schema_dirs": attr.label_list(allow_files = True, doc = "Files whose directories hold local schema JSON files, layered last."),
        "include": attr.string_list(doc = "Type-name globs to include (default: everything)."),
        "exclude": attr.string_list(doc = "Type-name globs to exclude."),
    },
)
