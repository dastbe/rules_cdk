load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "deploy",
    srcs = ["deploy.go"],
    importpath = "github.com/dastbe/rules_cdk/cfn/internal/deploy",
    visibility = ["//cfn:__subpackages__"],
    deps = [
        "//cfn/internal/manifest",
        "//cfn/internal/tmpldiff",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_cloudformation//:cloudformation",
        "@com_github_aws_aws_sdk_go_v2_service_cloudformation//types",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_aws_aws_sdk_go_v2_service_sts//:sts",
        "@com_github_aws_smithy_go//:smithy-go",
    ],
)

go_test(
    name = "deploy_test",
    srcs = ["deploy_test.go"],
    embed = [":deploy"],
    deps = [
        "//cfn/internal/manifest",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_cloudformation//:cloudformation",
        "@com_github_aws_aws_sdk_go_v2_service_cloudformation//types",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_aws_aws_sdk_go_v2_service_sts//:sts",
        "@com_github_aws_smithy_go//:smithy-go",
    ],
)
